{
  "name": "periscope",
  "version": "0.1.0",
  "description": "Browse, search and watch Claude Code, Codex and Antigravity CLI transcripts",
  "private": true,
  "type": "module",
  "bin": {
    "periscope": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE*"
  ],
  "engines": {
    "node": ">=26.4.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli/index.js', 0o755)\"",
    "prepare": "npm run build",
    "test": "node --test --disable-warning=ExperimentalWarning 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@opentui/core": "0.8.4"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2"
  }
}
